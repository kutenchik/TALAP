{
  "schema_version": 1,
  "purpose": "Initial US undergraduate international-applicant recommendation coverage cohort.",
  "selection": {
    "count": 100,
    "public_count": 70,
    "private_count": 30,
    "note": "Coverage cohort, not a ranking. Institutions are selected to create useful variation in cost, selectivity, geography, institution type, and program breadth."
  },
  "recommendation_ready_contract": {
    "required": [
      "canonical_identity_with_ipeds_unitid",
      "operating_bachelors_granting_status",
      "location_and_ownership",
      "undergraduate_programs_with_cip_mapping",
      "published_cost_or_cost_of_attendance_with_source_and_year",
      "official_international_english_proficiency_policy",
      "at_least_one_academic_positioning_signal_or_explicit_unavailable_state",
      "source_provenance_for_every_requirement_used_by_recommender"
    ],
    "allowed_missing": [
      "sat_act_if_not_reported_or_not_used",
      "scholarship_amount",
      "program_specific_deadline",
      "campus_preference_metadata"
    ],
    "rule": "Unknown facts remain unknown. Missing English-policy verification prevents recommendation_ready=true."
  },
  "journey_ready_additional_contract": {
    "required": [
      "verified_application_deadline_or_rolling_admissions_state",
      "application_platform_or_process_source",
      "verified_required_documents_at_general_undergraduate_level"
    ]
  },
